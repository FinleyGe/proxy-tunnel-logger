# Proxy listen address and port (Docker image defaults PROXY_HOST to 0.0.0.0)
PROXY_HOST=127.0.0.1
PROXY_PORT=8080

# Web UI listen address and port (Docker image defaults UI_HOST to 0.0.0.0)
UI_HOST=127.0.0.1
UI_PORT=3000

# Directory containing logs.jsonl (Docker image defaults DATA_DIR to /data)
DATA_DIR=./data

# Per-body capture limit in bytes stored in JSONL (10 MiB default; 0 = unlimited)
MAX_BODY_BYTES=10485760

# Optional reverse-proxy target origin for origin-form requests (leave empty for forward proxy only)
# UPSTREAM=https://api.example.com
